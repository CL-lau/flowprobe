{
  "name": "flowprobe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contract-driven hybrid web testing platform",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-assets.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:acceptance": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "flowprobe": "tsx packages/cli/src/main.ts",
    "simulator": "tsx examples/simulator/server.ts",
    "format": "prettier --write \"packages/**/*.ts\" \"examples/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.config.ts\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"examples/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.config.ts\""
  },
  "dependencies": {
    "@playwright/test": "1.65.0",
    "commander": "15.0.0",
    "esbuild": "0.28.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "@midscene/web": "1.17.7"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "uuid": "11.1.1",
    "sharp": "0.35.5",
    "basic-ftp": "6.2.6"
  }
}
